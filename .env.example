# --- Asosiy ---
SECRET_KEY=bu-yerga-maxfiy-kalit
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

# --- Baza ---
# PostgreSQL o'rnatilgach USE_SQLITE=0 qiling va parolni yozing.
USE_SQLITE=1
DB_NAME=samyosh
DB_USER=postgres
DB_PASSWORD=parolingiz
DB_HOST=127.0.0.1
DB_PORT=5432

# --- Telegram bot ---
TELEGRAM_BOT_USERNAME=yoshtadbirkorlarbot
TELEGRAM_API_SECRET=maxfiy-kalit

# --- Frontend (Next.js) ---
# Front alohida papkada yotadi. Serverda papka nomi boshqacha bo'lsa
# shu yerda ko'rsatiladi — `docker compose` va `deploy.sh` shundan oladi.
FRONT_PATH=../Sma_yoshlar_bot/sam_yoshlar_front

# Brauzer API ga shu manzil orqali murojaat qiladi.
# Qurish paytida kodga yoziladi, keyin o'zgartirib bo'lmaydi —
# o'zgartirsangiz frontni qayta qurish kerak.
PUBLIC_API_URL=http://127.0.0.1:8000/api/v1

# Bot havolalarda ishlatadigan sayt manzili
SITE_URL=http://127.0.0.1:8000
BOT_PATH=../Sma_yoshlar_bot/sam_yoshlar_bot


# ==========================================================================
# SERVERDA (mentadbirkor.uz) qiymatlar shunday bo'ladi:
#
#   DEBUG=0
#   SECRET_KEY=<uzun tasodifiy satr>
#   ALLOWED_HOSTS=mentadbirkor.uz,www.mentadbirkor.uz
#     (`web` avtomatik qo'shiladi — front ichki tarmoq orqali shunday murojaat qiladi)
#   CSRF_TRUSTED_ORIGINS=https://mentadbirkor.uz,https://www.mentadbirkor.uz
#   CORS_ALLOWED_ORIGINS=https://mentadbirkor.uz,https://www.mentadbirkor.uz
#
#   USE_SQLITE=0
#   DB_PASSWORD=<kuchli parol>
#
#   FRONT_PATH=../sam_yoshlar_front_git
#   PUBLIC_API_URL=https://mentadbirkor.uz/api/v1
#   SITE_URL=https://mentadbirkor.uz
# ==========================================================================

# --- Tezlik sozlamalari ---
# Kesh (docker-compose o'zi beradi; lokalda bo'sh qoldiring)
REDIS_URL=

# Django worker soni: (yadro soni × 2) + 1. 4 yadro -> 9
GUNICORN_WORKERS=9
GUNICORN_THREADS=2
