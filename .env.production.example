DB_PORT=5432

# --- Statik fayllar ---
USE_WHITENOISE=1

# --- Telegram bot ---
TELEGRAM_BOT_USERNAME=yoshtadbirkorlarbot
TELEGRAM_API_SECRET=bot-.env-dagi-API_SECRET-bilan-bir-xil

# --- Bot uchun (docker-compose o'qiydi) ---
