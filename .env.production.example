# --- Asosiy ---
SECRET_KEY=bu-yerga-uzun-maxfiy-kalit-qoying
DEBUG=0
ALLOWED_HOSTS=samyosh.uz,www.samyosh.uz
CSRF_TRUSTED_ORIGINS=https://samyosh.uz,https://www.samyosh.uz

# nginx allaqachon HTTPS ga yo'naltiradi, shuning uchun 0 qoldiring
SECURE_SSL_REDIRECT=0

# --- Baza (PostgreSQL, docker ichida) ---
USE_SQLITE=0
DB_NAME=samyosh
DB_USER=samyosh
DB_PASSWORD=kuchli-parol-yozing
