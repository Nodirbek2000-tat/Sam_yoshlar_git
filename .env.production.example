# ============ Serverga qo'yish uchun namuna ============
# Nusxa oling:  cp .env.production.example .env
# va qiymatlarni to'ldiring.

# --- Asosiy ---
SECRET_KEY=bu-yerga-uzun-maxfiy-kalit-qoying
DEBUG=0
ALLOWED_HOSTS=mentadbirkor.uz,www.mentadbirkor.uz
CSRF_TRUSTED_ORIGINS=https://mentadbirkor.uz,https://www.mentadbirkor.uz

# nginx allaqachon HTTPS ga yo'naltiradi, shuning uchun 0 qoldiring
SECURE_SSL_REDIRECT=0

# --- Baza (PostgreSQL, docker ichida) ---
USE_SQLITE=0
DB_NAME=samyosh
DB_USER=samyosh
DB_PASSWORD=kuchli-parol-yozing
DB_HOST=db
DB_PORT=5432

# --- Statik fayllar ---
USE_WHITENOISE=1

# --- Telegram bot ---
TELEGRAM_BOT_USERNAME=yoshtadbirkorlarbot
TELEGRAM_API_SECRET=bot-.env-dagi-API_SECRET-bilan-bir-xil

# --- Frontend (Next.js) ---
# Brauzer API ga shu manzil orqali murojaat qiladi.
# Qurish paytida kodga yoziladi — o'zgartirsangiz frontni qayta build qiling.
PUBLIC_API_URL=https://mentadbirkor.uz/api/v1

# Frontend brauzerdan shu manzillardan murojaat qiladi
CORS_ALLOWED_ORIGINS=https://mentadbirkor.uz,https://www.mentadbirkor.uz

# --- Bot uchun (docker-compose o'qiydi) ---
SITE_URL=https://mentadbirkor.uz

# --- Email (ixtiyoriy) ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=sam-yosh tadbirkor <info@mentadbirkor.uz>

# --- Papkalar (docker-compose shu yo'llardan quradi) ---
FRONT_PATH=../Sma_yoshlar_bot/sam_yoshlar_front
BOT_PATH=../Sma_yoshlar_bot/sam_yoshlar_bot
